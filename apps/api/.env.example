# Copy to apps/api/.env

DATABASE_URL=postgres://localhost:5432/jobapp
PORT=4000

# --- Job sources -----------------------------------------------------------
# JSearch on RapidAPI (covers LinkedIn, Indeed, Glassdoor via Google for Jobs).
# Leave empty to skip. Free tier is ~200 requests/month: each title x market x page = 1 request.
JSEARCH_API_KEY=
JSEARCH_PAGES_PER_QUERY=1

# Public company boards, no key needed. provider:boardToken, comma separated.
# providers: greenhouse (boards.greenhouse.io/<token>), lever (jobs.lever.co/<token>), ashby (jobs.ashbyhq.com/<token>)
ATS_BOARDS=greenhouse:stripe,greenhouse:airbnb,lever:spotify,ashby:ramp

# Used for JSearch until users have set their own target titles / markets.
DEFAULT_TARGET_TITLES=software engineer,product manager,data analyst
# global | country:US | city:US:Austin   (comma separated)
DEFAULT_MARKETS=global

# --- Schedules -------------------------------------------------------------
INGEST_CRON=0 */4 * * *
SWEEP_CRON=30 3 * * *
JOB_MAX_AGE_DAYS=45

# --- Files -----------------------------------------------------------------
STORAGE_DIR=./storage
# The URL your phone/simulator uses to reach the API (use your Mac's LAN IP for a real device)
PUBLIC_BASE_URL=http://localhost:4000
FILE_SIGNING_SECRET=dev-only-signing-secret-change-me
SIGNED_URL_TTL_SECONDS=3600
MAX_UPLOAD_MB=10
