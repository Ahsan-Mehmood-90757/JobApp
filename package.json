{
  "name": "jobapp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm run dev -w @jobapp/api",
    "api:worker": "npm run worker -w @jobapp/api",
    "db:migrate": "npm run migrate -w @jobapp/api",
    "ingest": "npm run ingest -w @jobapp/api",
    "sweep": "npm run sweep -w @jobapp/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
